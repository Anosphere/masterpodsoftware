PORT=3100
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=masterpod
PGUSER=masterpodsoftware
PGPASSWORD=change-me
# Comma-separated list of web origins: the CORS allow-list and the WebAuthn expected origins.
WEB_ORIGIN=http://localhost:4200
RP_ID=localhost
EPHEMERAL_KEY_HOURS=12
CHALLENGE_SECONDS=120
TIMESTAMP_WINDOW_SECONDS=120
MAX_IMAGE_BYTES=10485760
MAX_IMAGES_PER_REQUEST=5
# This server as the keyholders reach it; the banker packet's URL is built from it.
RECOVERY_POD_URL_BASE=http://localhost:3100
# The validators asked for the DAO stake list, in order; on the servers the doormen's URLs (the wallet's list).
VALIDATOR_URLS=http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:3004,http://localhost:3005
# The least DAO votes (whole staked anos) a pod needs in the snapshot to post a proposal.
DAO_PROPOSE_MIN_VOTES=1
# The percent of all DAO votes a pending proposal needs in support to go to a vote.
DAO_PROPOSAL_PERCENT=15
# For must be more than this percent of the votes cast; at most 99, so a tie fails.
DAO_PASS_PERCENT=50
# How long a proposal may collect support, in minutes (a week).
DAO_PENDING_MINUTES=10080
# How long an open proposal takes votes, in minutes (two weeks).
DAO_VOTE_MINUTES=20160
