PORT=3100
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=masterpod
PGUSER=masterpodsoftware
PGPASSWORD=change-me
# Comma-separated list of web origins: the CORS allow-list and the WebAuthn expected origins.
WEB_ORIGIN=http://localhost:4200
RP_ID=localhost
EPHEMERAL_KEY_HOURS=12
CHALLENGE_SECONDS=120
# Life of a challenge for /add-passkey, in seconds (ten minutes).
ADD_PASSKEY_CHALLENGE_SECONDS=600
TIMESTAMP_WINDOW_SECONDS=120
MAX_IMAGE_BYTES=10485760
MAX_IMAGES_PER_REQUEST=5
# This server as the keyholders reach it; the banker packet's URL is built from it.
RECOVERY_POD_URL_BASE=http://localhost:3100
# The validators asked for the DAO stake list, in order; on the servers the doormen's URLs (the wallet's list).
VALIDATOR_URLS=http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:3004,http://localhost:3005
# The least DAO votes (whole staked anos) a pod needs in the snapshot to post a proposal.
DAO_PROPOSE_MIN_VOTES=1
# The percent of all DAO votes a pending proposal needs in support to go to a vote.
DAO_PROPOSAL_PERCENT=15
# For must be more than this percent of the votes cast; at most 99, so a tie fails.
DAO_PASS_PERCENT=50
# How long a proposal may collect support, in minutes (a week).
DAO_PENDING_MINUTES=10080
# How long an open proposal takes votes, in minutes (two weeks).
DAO_VOTE_MINUTES=20160
# Security alerts (spec section 25). Email is on when both lines are set.
# RESEND_API_KEY=
# ALERT_EMAIL_FROM="anoPod wallet <alerts@wallet.anocloud.com>"
# Notifications on the phone are on when both lines are set. The key is made by: npm run make-alert-push-key -- <file>
# ALERT_PUSH_PRIVATE_KEY=
# ALERT_PUSH_CONTACT=https://wallet.anocloud.com
# How long an email or a phone that was taken off still gets every alert, in minutes (a month).
# ALERT_REMOVE_MINUTES=43200
# The validators' public keys, for their reports of waiting transfers.
# VALIDATOR_KEYS_FILE=network/validators.json
# Joy, the wallet's AI (spec section 30). Joy is on when the key is set. The key is made in Anthropic's Console.
# ANTHROPIC_API_KEY=
# The model that writes Joy's answers.
# JOY_MODEL=claude-haiku-5-5
# How hard the model thinks before it answers: low, medium or high.
# JOY_EFFORT=medium
# The most tokens one request to Anthropic may write, the model's thinking included.
# JOY_MAX_TOKENS=16000
# How many messages one pod may send Joy in one day (UTC).
# JOY_DAILY_MESSAGES=300
# Joy's web search (spec section 32). The most web searches for one message. 0 switches web search off.
# JOY_MAX_SEARCHES=3
# From how many web searches in one day (UTC) a pod's further messages go out without web search. 0 switches web search off.
# JOY_DAILY_SEARCHES=100
# Joy's pictures (spec section 33). Joy can have a picture made when the key is set. The key is made on OpenAI's page, platform.openai.com/api-keys.
# OPENAI_API_KEY=
# OpenAI's image model.
# JOY_PICTURE_MODEL=gpt-image-2.6-flare
# The quality of a picture: low, medium or high.
# JOY_PICTURE_QUALITY=low
# The width and the height of a picture, in pixels.
# JOY_PICTURE_SIZE=1024x1024
# The file format of a picture: jpeg, png or webp.
# JOY_PICTURE_FORMAT=jpeg
# From how many pictures in one day (UTC) a pod's further messages go out without the picture tool. 0 switches pictures off.
# JOY_DAILY_PICTURES=30
