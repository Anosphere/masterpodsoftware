{
  "name": "masterpodsoftware",
  "version": "0.1.0",
  "description": "The masterpod server: an Express 5 server backed by PostgreSQL",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node --env-file=.env src/server.js",
    "dev": "node --watch --env-file=.env src/server.js",
    "db:setup": "sh scripts/setup-db.sh",
    "db:reset": "sh scripts/reset-db.sh",
    "make-super-seed": "node --env-file=.env scripts/make-super-seed.js",
    "appoint": "node --env-file=.env scripts/appoint.js",
    "revoke": "node --env-file=.env scripts/revoke.js"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "dependencies": {
    "@simplewebauthn/server": "^14.0.3",
    "canonicalize": "^5.1.0",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "pg": "^8.23.1"
  }
}
